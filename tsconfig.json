{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noImplicitAny": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "target": "es2020",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "global.d.ts"]
}
